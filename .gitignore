# Database (regenerated by `npm run pipeline`)
*.db
*.db-journal
*.sqlite3

# Uploaded audio (user data, not source)
app/uploads/*
!app/uploads/.gitkeep

# Secrets
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# n8n local runtime
n8n/.n8n/
node_modules/

# SQLite sidecar files (WAL mode)
*.db-shm
*.db-wal

# Audio fixtures ARE committed (small, and the tests need them) - see
# tests/fixtures/generate.js to regenerate.
