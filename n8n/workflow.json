{
  "name": "ConsultBae - LLM skill categorisation",
  "nodes": [
    {
      "parameters": {},
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "When clicking Execute",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-620, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg-1",
              "name": "apiBaseUrl",
              "value": "http://localhost:8000",
              "type": "string"
            },
            {
              "id": "cfg-2",
              "name": "geminiModel",
              "value": "gemini-flash-lite-latest",
              "type": "string"
            },
            {
              "id": "cfg-3",
              "name": "batchLimit",
              "value": 50,
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-420, 300],
      "notes": "Change apiBaseUrl to your ngrok URL if n8n runs in the cloud."
    },
    {
      "parameters": {
        "url": "={{ $json.apiBaseUrl }}/api/people?untagged=true&limit={{ $json.batchLimit }}",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Get untagged people",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-200, 300],
      "notes": "Reads straight from the merged SQLite DB built by Task 1, via the app's JSON API."
    },
    {
      "parameters": {
        "options": {
          "reset": false
        }
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Loop over people",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [20, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/{{ $('Config').first().json.geminiModel }}:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  contents: [{ parts: [{ text: `You are classifying a freelance worker into ONE skill category.\\n\\nAllowed categories, choose exactly one:\\n- automation-heavy  (n8n, Zapier, LangChain, workflow tooling)\\n- web-dev           (React, JavaScript, front-end)\\n- data              (Pandas, SQL, analytics, data pipelines)\\n- qa-automation     (Selenium, testing, web scraping)\\n- backend           (FastAPI, Docker, MongoDB, MySQL, REST APIs)\\n\\nWorker: ${$json.full_name}\\nSkills: ${$json.skills}\\n\\nReply with the category slug only. No punctuation, no explanation.` }] }],\n  generationConfig: { temperature: 0, maxOutputTokens: 512 }\n}) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "retryOnFail": true,
      "maxTries": 4,
      "waitBetweenTries": 2000,
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Gemini - classify skills",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 420],
      "credentials": {
        "httpHeaderAuth": {
          "id": "gemini-api-key",
          "name": "Gemini API Key"
        }
      },
      "notes": "Header Auth credential: name = x-goog-api-key, value = your key. NOT Bearer (401). maxOutputTokens must be generous: flash models spend tokens on internal reasoning first, so a small budget returns an empty string. Retries handle the 503 UNAVAILABLE this endpoint returns under load."
    },
    {
      "parameters": {
        "jsCode": "// Never trust the model's raw text. Pull out the reply, normalise it, and keep\n// it only if it is one of the five categories we actually allow. Anything else\n// is marked invalid and skipped rather than written to the database.\n\nconst ALLOWED = ['automation-heavy', 'web-dev', 'data', 'qa-automation', 'backend'];\nconst out = [];\n\nfor (const item of $input.all()) {\n  const person = $('Loop over people').first().json;\n  const raw = item.json?.candidates?.[0]?.content?.parts?.[0]?.text ?? '';\n\n  // Models like to add punctuation, quotes, or a whole sentence.\n  const cleaned = String(raw).toLowerCase().replace(/[^a-z-]/g, ' ').trim();\n  const category = ALLOWED.find((c) => cleaned.split(/\\s+/).includes(c))\n    ?? ALLOWED.find((c) => cleaned.includes(c))\n    ?? null;\n\n  out.push({\n    json: {\n      person_id: person.person_id,\n      full_name: person.full_name,\n      skills: person.skills,\n      raw_reply: String(raw).trim(),\n      skill_category: category,\n      valid: Boolean(category),\n    },\n  });\n}\n\nreturn out;"
      },
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Validate category",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 420]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "valid-check",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "Usable category?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [700, 420]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $('Config').first().json.apiBaseUrl }}/api/people/{{ $json.person_id }}/tag",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ skill_category: $json.skill_category }) }}",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000008",
      "name": "Write category back",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [940, 320],
      "notes": "The API re-validates against the same allow-list, so a bad value is rejected even if this flow is wrong."
    },
    {
      "parameters": {},
      "id": "a1000000-0000-4000-8000-000000000009",
      "name": "Skip - unusable reply",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [940, 520]
    },
    {
      "parameters": {
        "url": "={{ $('Config').first().json.apiBaseUrl }}/api/stats",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000010",
      "name": "Get final stats",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 160]
    },
    {
      "parameters": {
        "jsCode": "// Build a one-line summary for the alert.\nconst s = $input.first().json;\nconst text = `ConsultBae skill tagging run complete.\\n`\n  + `• ${s.tagged} of ${s.people} people now have a skill category\\n`\n  + `• ${s.submissions} audio submissions in the database\\n`\n  + `• ${s.issues} data-quality issues logged by the merge pipeline`;\n\nreturn [{ json: { text, ...s } }];"
      },
      "id": "a1000000-0000-4000-8000-000000000011",
      "name": "Build summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 160]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=YOUR_SLACK_OR_DISCORD_WEBHOOK_URL",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.text, content: $json.text }) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "a1000000-0000-4000-8000-000000000012",
      "name": "Post summary alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 160],
      "notes": "Paste a Slack or Discord incoming-webhook URL here. Body carries both 'text' (Slack) and 'content' (Discord) so either works."
    }
  ],
